---
layout: default
---
<div class="post publisher-container" id="publisher-app" data-baseurl="{{ site.baseurl | escape }}" data-author="{{ site.first_name | escape }}" data-avatar="{{ '/assets/img/profile.jpg' | relative_url }}">
  <!-- 认证与登录界面（未输入 Token 时展示） -->
  <section id="publisher-auth-section" class="publisher-auth-card">
    <div class="publisher-auth-icon">
      <i class="fa-solid fa-shield-halved"></i>
    </div>
    <h1 class="publisher-auth-title">个人专属主页管理中心</h1>
    <p class="publisher-auth-subtitle">基于 GitHub REST API 的纯前端站点内容、简历与图片管理系统</p>

    <div class="publisher-auth-guide">
      <strong><i class="fa-solid fa-lightbulb text-warning mr-1"></i> 如何获取您的 GitHub Token？</strong>
      <ol class="mt-2">
        <li>访问 GitHub 的 <a href="https://github.com/settings/tokens?type=beta" target="_blank" rel="noopener noreferrer">Fine-grained personal access tokens</a> 页面。</li>
        <li>点击 <strong>Generate new token</strong>，名称填写 <code>mypage-cms</code>。</li>
        <li><strong>Repository access</strong> 选择 <strong>Only select repositories</strong> 并勾选您的主页仓库（如 <code>MyPage-suihan</code>）。</li>
        <li><strong>Permissions</strong> -> <strong>Repository permissions</strong> -> 找到 <strong>Contents</strong>，设置为 <strong>Read and write</strong>，生成并复制 Token。</li>
      </ol>
      <small class="text-muted"><i class="fa-solid fa-lock"></i> 您的 Token 仅保存在当前浏览器本地，绝不经由任何第三方服务器。</small>
    </div>

    <form id="publisher-auth-form" autocomplete="off">
      <div class="form-group text-left mb-3">
        <label for="input-github-token" class="font-weight-bold">GitHub Personal Access Token (PAT) <span class="text-danger">*</span></label>
        <textarea id="input-github-token" name="github-api-token" class="form-control publisher-token-input" rows="2" placeholder="粘贴 GitHub Token" required autocomplete="off" autocapitalize="off" spellcheck="false" data-lpignore="true" data-1p-ignore aria-describedby="github-token-help"></textarea>
        <button type="button" id="github-token-toggle" class="btn btn-sm btn-outline-secondary mt-2" aria-pressed="false">显示 Token</button>
        <small id="github-token-help" class="d-block text-muted mt-2">这是管理凭证，与旅行访问密码分开保存。连接成功后，本浏览器会记住它。</small>
      </div>

      <div class="row">
        <div class="col-md-5 form-group text-left mb-3">
          <label for="input-github-owner" class="font-weight-bold">GitHub 用户名</label>
          <input type="text" id="input-github-owner" name="github-repository-owner" autocomplete="off" class="form-control" value="suihan-shu" required>
        </div>
        <div class="col-md-5 form-group text-left mb-3">
          <label for="input-github-repo" class="font-weight-bold">仓库名</label>
          <input type="text" id="input-github-repo" class="form-control" value="MyPage-suihan" required>
        </div>
        <div class="col-md-2 form-group text-left mb-3">
          <label for="input-github-branch" class="font-weight-bold">分支</label>
          <input type="text" id="input-github-branch" class="form-control" value="main" required>
        </div>
      </div>

      <button type="submit" class="btn btn-primary btn-block btn-lg mt-3" style="border-radius: 8px;">
        <i class="fa-solid fa-key mr-1"></i> 解锁并进入管理中心
      </button>
      <p id="publisher-auth-status" class="mt-3 mb-0" role="status" aria-live="polite"></p>
    </form>
  </section>

  <!-- 主工作台（已认证后展示） -->
  <section id="publisher-main-section" hidden>
    <!-- 顶部状态栏 -->
    <div class="publisher-topbar">
      <div id="publisher-user-badge" class="publisher-user-badge">
        <!-- JS 动态注入头像和仓库名 -->
      </div>
      <div class="d-flex align-items-center gap-2 flex-wrap">
        <span id="publisher-actions-status"></span>
        <a href="{{ '/' | relative_url }}" class="btn btn-sm btn-outline-info" target="_blank">
          <i class="fa-solid fa-house"></i> 访问主页
        </a>
        <a href="{{ '/cv/' | relative_url }}" class="btn btn-sm btn-outline-info" target="_blank">
          <i class="fa-solid fa-file-lines"></i> 查看简历
        </a>
        <a href="{{ '/travel/' | relative_url }}" class="btn btn-sm btn-outline-info" target="_blank">
          <i class="fa-solid fa-route"></i> 查看旅行日志
        </a>
        <button id="publisher-logout-btn" type="button" class="btn btn-sm btn-outline-danger">
          <i class="fa-solid fa-right-from-bracket"></i> 退出锁定
        </button>
      </div>
    </div>

    <!-- 功能选项卡 -->
    <div class="publisher-tabs" role="tablist">
      <button class="publisher-tab-btn active" data-publisher-tab="cv" type="button" role="tab">
        <i class="fa-solid fa-file-lines"></i> 简历可视化编辑 (Resume)
      </button>
      <button class="publisher-tab-btn" data-publisher-tab="travel" type="button" role="tab">
        <i class="fa-solid fa-route"></i> 我的旅行动态
      </button>
      <button class="publisher-tab-btn" data-publisher-tab="about" type="button" role="tab">
        <i class="fa-solid fa-user-pen"></i> 关于我与简介 (About Me)
      </button>
      <button class="publisher-tab-btn" data-publisher-tab="files" type="button" role="tab">
        <i class="fa-solid fa-code"></i> 万能配置与文件 (Site Editor)
      </button>
    </div>

    <!-- 选项卡 1：简历可视化编辑 -->
    <div id="pane-cv" class="publisher-pane active" role="tabpanel">
      <div class="publisher-card">
        <div class="publisher-card-header">
          <h2 class="publisher-card-title"><i class="fa-solid fa-file-pen"></i> 个人简历在线编辑</h2>
          <small class="text-muted">填写表单直接同步并更新 <code>_data/cv.yml</code></small>
        </div>

        <form id="cms-cv-form">
          <!-- 基础信息 -->
          <h5 class="border-bottom pb-2 mb-3 text-primary"><i class="fa-solid fa-id-card"></i> 1. 基本信息与联系方式</h5>
          <div class="row mb-3">
            <div class="col-md-6 form-group">
              <label for="cv-name" class="font-weight-bold">姓名</label>
              <input type="text" id="cv-name" class="form-control" placeholder="何岁寒">
            </div>
            <div class="col-md-6 form-group">
              <label for="cv-label" class="font-weight-bold">专业</label>
              <input type="text" id="cv-label" class="form-control" placeholder="航空工程">
            </div>
          </div>
          <div class="row mb-3">
            <div class="col-md-4 form-group">
              <label for="cv-email" class="font-weight-bold">电子邮箱</label>
              <input type="email" id="cv-email" class="form-control" placeholder="suihan_shu@163.com">
            </div>
            <div class="col-md-4 form-group">
              <label for="cv-phone" class="font-weight-bold">联系电话</label>
              <input type="text" id="cv-phone" class="form-control" placeholder="15282399475">
            </div>
            <div class="col-md-4 form-group">
              <label for="cv-location" class="font-weight-bold">地址 / 现居地点</label>
              <input type="text" id="cv-location" class="form-control" placeholder="西安，中国">
            </div>
          </div>

          <div class="row mb-3">
            <div class="col-12 form-group">
              <label for="cv-desc" class="font-weight-bold">简历副标题 / 描述文字 <small class="text-muted">(留空则不显示)</small></label>
              <input type="text" id="cv-desc" class="form-control" placeholder="留空则不显示副标题，例如：保持好奇，持续探索与创造。">
            </div>
          </div>

          <!-- 个人简介 -->
          <h5 class="border-bottom pb-2 mb-3 mt-4 text-primary"><i class="fa-solid fa-comment-dots"></i> 2. 个人简介 (Summary)</h5>
          <div class="form-group mb-3">
            <textarea id="cv-summary" class="form-control" rows="3" placeholder="一段简短的自我评价或职业方向描述..."></textarea>
          </div>

          <!-- 教育经历 -->
          <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3 mt-4">
            <h5 class="mb-0 text-primary"><i class="fa-solid fa-graduation-cap"></i> 3. 教育经历</h5>
            <button id="cv-add-edu-btn" type="button" class="btn btn-sm btn-outline-primary">
              <i class="fa-solid fa-plus"></i> 添加一条教育经历
            </button>
          </div>
          <div id="cv-edu-container" class="mb-3">
            <!-- 动态注入教育条目 -->
          </div>

          <!-- 项目经历 -->
          <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3 mt-4">
            <h5 class="mb-0 text-primary"><i class="fa-solid fa-diagram-project"></i> 4. 项目 / 工作经历</h5>
            <button id="cv-add-exp-btn" type="button" class="btn btn-sm btn-outline-primary">
              <i class="fa-solid fa-plus"></i> 添加一条经历
            </button>
          </div>
          <div id="cv-exp-container" class="mb-3">
            <!-- 动态注入经历条目 -->
          </div>

          <!-- 获奖经历 -->
          <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3 mt-4">
            <h5 class="mb-0 text-primary"><i class="fa-solid fa-trophy"></i> 5. 获奖经历 / 荣誉</h5>
            <button id="cv-add-award-btn" type="button" class="btn btn-sm btn-outline-primary">
              <i class="fa-solid fa-plus"></i> 添加一条获奖经历
            </button>
          </div>
          <div id="cv-award-container" class="mb-3">
            <!-- 动态注入获奖条目 -->
          </div>

          <!-- 专业技能 -->
          <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3 mt-4">
            <h5 class="mb-0 text-primary"><i class="fa-solid fa-screwdriver-wrench"></i> 6. 专业技能</h5>
            <button id="cv-add-skill-btn" type="button" class="btn btn-sm btn-outline-primary">
              <i class="fa-solid fa-plus"></i> 添加技能分类
            </button>
          </div>
          <div id="cv-skill-container" class="mb-3">
            <!-- 动态注入技能条目 -->
          </div>

          <!-- 兴趣爱好 -->
          <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3 mt-4">
            <h5 class="mb-0 text-primary"><i class="fa-solid fa-heart"></i> 7. 兴趣爱好</h5>
            <button id="cv-add-interest-btn" type="button" class="btn btn-sm btn-outline-primary">
              <i class="fa-solid fa-plus"></i> 添加兴趣分类
            </button>
          </div>
          <div id="cv-interest-container" class="mb-3">
            <!-- 动态注入兴趣条目 -->
          </div>

          <!-- 语言能力 -->
          <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3 mt-4">
            <h5 class="mb-0 text-primary"><i class="fa-solid fa-language"></i> 8. 语言能力</h5>
            <button id="cv-add-lang-btn" type="button" class="btn btn-sm btn-outline-primary">
              <i class="fa-solid fa-plus"></i> 添加语言能力
            </button>
          </div>
          <div id="cv-lang-container" class="mb-3">
            <!-- 动态注入语言条目 -->
          </div>

          <button id="cv-submit-btn" type="submit" class="btn btn-primary btn-lg btn-block mt-4" style="border-radius: 8px;">
            <i class="fa-solid fa-floppy-disk"></i> 保存并更新简历到 GitHub
          </button>
        </form>
      </div>
    </div>

    <!-- 旅行动态：编辑器与已发布列表共用同一数据来源 -->
    <div id="pane-travel" class="publisher-pane" role="tabpanel">
      <div id="travel-manager" class="moments-manager">
        <div class="moments-manager__heading">
          <div><p class="travel-log-eyebrow">记录生活里的小片刻</p><h2>我的旅行动态</h2><p class="text-muted">写几句话，选几张照片，留一个地点。</p></div>
          <button type="button" id="travel-new-btn" class="btn btn-primary">＋ 写一条动态</button>
        </div>
        <p id="travel-manager-status" role="status" aria-live="polite"></p>
        <div class="moments-workspace">
          <div class="publisher-card moments-composer">
            <form id="cms-travel-form" autocomplete="off">
              <fieldset id="travel-editor-fields" disabled>
                <div class="moments-editor-heading"><h3 id="travel-editor-title">写一条动态</h3><span id="travel-edit-badge" hidden>正在编辑</span></div>
                <label for="travel-entry-summary">这一刻，想说些什么？</label>
                <textarea id="travel-entry-summary" class="form-control" rows="5" placeholder="风景、心情，或一个值得记住的瞬间…"></textarea>
                <div class="moments-photo-heading"><label for="travel-photos-input">照片</label><span id="travel-photo-count">0 / 9</span></div>
                <div id="travel-photo-editor" class="moments-photo-editor" aria-label="照片预览与排序"></div>
                <label class="moments-upload" for="travel-photos-input"><span aria-hidden="true">＋</span> 添加照片<input type="file" id="travel-photos-input" accept="image/jpeg,image/png,image/webp,image/gif" multiple></label>
                <small class="text-muted d-block">最多添加 9 张照片，可调整顺序。也可以只发文字或照片。</small>
                <label for="travel-entry-dest" class="mt-3"><i class="fa-solid fa-location-dot" aria-hidden="true"></i> 在哪里 <span class="text-muted">（选填）</span></label>
                <input id="travel-entry-dest" type="text" class="form-control" placeholder="例如：四川 · 四姑娘山" autocomplete="off">
                <details class="moments-date-options"><summary>记录时间</summary><label for="travel-entry-dates">日期或时间段</label><input id="travel-entry-dates" type="text" class="form-control" placeholder="默认今天，也可以补记过去的旅行"></details>
                <div class="moments-editor-actions"><button id="travel-submit-btn" type="submit" class="btn btn-primary">发布动态</button><button id="travel-cancel-btn" type="button" class="btn btn-outline-secondary">清空</button></div>
              </fieldset>
            </form>
          </div>
          <aside class="moments-preview"><p class="moments-preview__label">朋友看到的样子 · 实时预览</p><div id="travel-live-preview"></div></aside>
        </div>
        <section class="moments-history" aria-labelledby="travel-history-heading">
          <div class="moments-manager__heading"><h3 id="travel-history-heading">已发布 <span id="travel-entry-count">0</span></h3><button type="button" id="travel-refresh-btn" class="btn btn-sm btn-outline-secondary">刷新列表</button></div>
          <div id="travel-management-list"></div>
          <p id="travel-management-empty" class="travel-journal__empty" hidden>还没有动态。把第一段旅途留在这里吧。</p>
        </section>
      </div>
    </div>

    <!-- 选项卡 3：关于我与个人简介 -->
    <div id="pane-about" class="publisher-pane" role="tabpanel">
      <div class="publisher-card">
        <div class="publisher-card-header">
          <h2 class="publisher-card-title"><i class="fa-solid fa-user-pen"></i> 关于我与个人简介管理</h2>
          <small class="text-muted">实时编辑并更新 <code>_pages/about.md</code></small>
        </div>

        <form id="cms-about-form">
          <div class="row mb-3">
            <div class="col-md-6 form-group">
              <label for="about-display-name" class="font-weight-bold">展示姓名 / 昵称</label>
              <input type="text" id="about-display-name" class="form-control" placeholder="何岁寒">
            </div>
            <div class="col-md-6 form-group">
              <label for="about-subtitle" class="font-weight-bold">个性签名 / 副标题</label>
              <input type="text" id="about-subtitle" class="form-control" placeholder="保持好奇，持续学习与创造。">
            </div>
          </div>

          <div class="form-group mb-3">
            <label for="about-bio-content" class="font-weight-bold">主页正文简介 (Markdown 格式)</label>
            <textarea id="about-bio-content" class="form-control" rows="8" placeholder="在此编辑您的主页简介文字..." style="font-size: 1rem; line-height: 1.6;"></textarea>
          </div>

          <div class="form-group mb-3">
            <label for="about-avatar-input" class="font-weight-bold">更换个人头像照片 (上传至 assets/img/profile.jpg)</label>
            <input type="file" id="about-avatar-input" class="form-control-file" accept="image/*">
          </div>

          <button id="about-submit-btn" type="submit" class="btn btn-primary btn-lg btn-block" style="border-radius: 8px;">
            <i class="fa-solid fa-floppy-disk"></i> 保存并更新个人简介
          </button>
        </form>
      </div>
    </div>

    <!-- 选项卡 4：万能配置与文件编辑器 -->
    <div id="pane-files" class="publisher-pane" role="tabpanel">
      <div class="publisher-card">
        <div class="publisher-card-header">
          <h2 class="publisher-card-title"><i class="fa-solid fa-file-code"></i> 万能配置与文件编辑器</h2>
          <small class="text-muted">在线读取并修改任意站点数据或页面文件</small>
        </div>

        <div class="row mb-3">
          <div class="col-md-5 form-group">
            <label for="raw-file-select" class="font-weight-bold">常用站点文件快捷选择</label>
            <select id="raw-file-select" class="form-control">
              <option value="_data/cv.yml">_data/cv.yml (个人经历与简历数据)</option>
              <option value="_pages/about.md">_pages/about.md (关于我与主页正文)</option>
              <option value="_data/travel.yml">_data/travel.yml (旅行日志数据)</option>
              <option value="_data/socials.yml">_data/socials.yml (社交链接与二维码)</option>
              <option value="_data/repositories.yml">_data/repositories.yml (代码库展示仓库)</option>
              <option value="_config.yml">_config.yml (全站核心配置)</option>
            </select>
          </div>
          <div class="col-md-5 form-group">
            <label for="raw-file-path" class="font-weight-bold">或输入自定义文件路径</label>
            <input type="text" id="raw-file-path" class="form-control" value="_data/cv.yml">
          </div>
          <div class="col-md-2 form-group d-flex align-items-end">
            <button id="raw-file-load-btn" type="button" class="btn btn-secondary btn-block">
              <i class="fa-solid fa-download"></i> 读取文件
            </button>
          </div>
        </div>

        <div class="form-group mb-3">
          <label for="raw-file-content" class="font-weight-bold">文件内容</label>
          <textarea id="raw-file-content" class="form-control" rows="16" style="font-family: var(--custom-font-code); font-size: 0.92rem;"></textarea>
        </div>

        <div class="row">
          <div class="col-md-9 form-group">
            <input type="text" id="raw-file-commit-msg" class="form-control" placeholder="Commit message (如 Update cv)">
          </div>
          <div class="col-md-3 form-group">
            <button id="raw-file-save-btn" type="button" class="btn btn-primary btn-block">
              <i class="fa-solid fa-floppy-disk"></i> 提交修改并保存
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

<!-- 脚本引入 -->
<script src="{{ '/assets/js/lib/js-yaml.min.js' | relative_url | bust_file_cache }}"></script>
<script src="{{ '/assets/js/cms-data.js' | relative_url | bust_file_cache }}"></script>
<script src="{{ '/assets/js/github-cms.js' | relative_url | bust_file_cache }}"></script>
<script src="{{ '/assets/js/travel-data.js' | relative_url | bust_file_cache }}"></script>
<script src="{{ '/assets/js/travel-images.js' | relative_url | bust_file_cache }}"></script>
<script src="{{ '/assets/js/travel-cms.js' | relative_url | bust_file_cache }}"></script>
<script src="{{ '/assets/js/publisher.js' | relative_url | bust_file_cache }}"></script>
